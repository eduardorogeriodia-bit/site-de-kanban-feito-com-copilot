{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": {
    "source": "functions",
    "runtime": "nodejs22"
  },
  "hosting": {
    "public": "public",
    "rewrites": [
      {
        "source": "/api/ai/**",
        "function": {
          "functionId": "aiApi",
          "region": "us-central1"
        }
      },
      {
        "source": "/home",
        "destination": "/index.html"
      },
      {
        "source": "/perfil",
        "destination": "/index.html"
      },
      {
        "source": "/perfil/**",
        "destination": "/index.html"
      },
      {
        "source": "/quadros",
        "destination": "/index.html"
      },
      {
        "source": "/quadros/**",
        "destination": "/index.html"
      },
      {
        "source": "/colegas",
        "destination": "/index.html"
      },
      {
        "source": "/tasks/**",
        "destination": "/index.html"
      }
    ],
    "ignore": [
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "/index.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/firebase-config.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "**/*.@(js|css)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=300"
          }
        ]
      }
    ]
  }
}
