rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function boardPath(boardId) {
      return /databases/$(database)/documents/kanbans/$(boardId);
    }

    function memberPath(boardId, userId) {
      return /databases/$(database)/documents/kanbans/$(boardId)/members/$(userId);
    }

    function isOwner(boardId) {
      return signedIn()
        && exists(boardPath(boardId))
        && get(boardPath(boardId)).data.ownerId == request.auth.uid;
    }

    function hasMembership(boardId) {
      return signedIn() && exists(memberPath(boardId, request.auth.uid));
    }

    function canReadBoard(boardId) {
      return isOwner(boardId) || hasMembership(boardId);
    }

    function canEditBoard(boardId) {
      return isOwner(boardId)
        || (hasMembership(boardId)
          && get(memberPath(boardId, request.auth.uid)).data.role == 'editor');
    }

    function invitePath(boardId, inviteId) {
      return /databases/$(database)/documents/kanbans/$(boardId)/invites/$(inviteId);
    }

    match /users/{userId}/kanban/{document=**} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    match /kanbans/{boardId} {
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0;
      allow read: if signedIn()
        && (resource.data.ownerId == request.auth.uid || hasMembership(boardId));
      allow update: if canEditBoard(boardId)
        && request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if isOwner(boardId);

      match /members/{memberId} {
        allow read: if canReadBoard(boardId);
        allow create: if signedIn()
          && request.auth.uid == memberId
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.role in ['editor', 'viewer']
          && request.resource.data.email == request.auth.token.email.lower()
          && exists(invitePath(boardId, request.resource.data.inviteId))
          && get(invitePath(boardId, request.resource.data.inviteId)).data.invitedEmail
            == request.auth.token.email.lower()
          && get(invitePath(boardId, request.resource.data.inviteId)).data.role
            == request.resource.data.role;
        allow update, delete: if isOwner(boardId);
      }

      match /invites/{inviteId} {
        allow read: if isOwner(boardId)
          || (signedIn()
            && resource.data.invitedEmail == request.auth.token.email.lower());
        allow create: if isOwner(boardId)
          && request.resource.data.ownerId == request.auth.uid
          && request.resource.data.boardId == boardId
          && request.resource.data.invitedEmail is string
          && request.resource.data.invitedEmail.size() > 3
          && request.resource.data.role in ['editor', 'viewer'];
        allow delete: if isOwner(boardId)
          || (signedIn()
            && resource.data.invitedEmail == request.auth.token.email.lower());
        allow update: if false;
      }

      match /tasks/{taskId}/comments/{commentId} {
        allow read: if canReadBoard(boardId);
        allow create: if canReadBoard(boardId)
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.authorEmail == request.auth.token.email
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000;
        allow update, delete: if signedIn()
          && (resource.data.authorId == request.auth.uid || isOwner(boardId));
      }

      match /activity/{activityId} {
        allow read: if canReadBoard(boardId);
        allow create: if canEditBoard(boardId)
          && request.resource.data.actorId == request.auth.uid;
        allow update: if false;
        allow delete: if isOwner(boardId);
      }
    }

    match /{path=**}/members/{memberId} {
      allow read: if signedIn()
        && resource.data.uid == request.auth.uid;
    }

    match /{path=**}/invites/{inviteId} {
      allow read: if signedIn()
        && resource.data.invitedEmail == request.auth.token.email.lower();
    }
  }
}
