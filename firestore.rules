rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function boardPath(boardId) {
      return /databases/$(database)/documents/kanbans/$(boardId);
    }

    function memberPath(boardId, userId) {
      return /databases/$(database)/documents/kanbans/$(boardId)/members/$(userId);
    }

    function isOwner(boardId) {
      return signedIn()
        && exists(boardPath(boardId))
        && get(boardPath(boardId)).data.ownerId == request.auth.uid;
    }

    function hasMembership(boardId) {
      return signedIn() && exists(memberPath(boardId, request.auth.uid));
    }

    function canReadBoard(boardId) {
      return isOwner(boardId) || hasMembership(boardId);
    }

    function canEditBoard(boardId) {
      return isOwner(boardId)
        || (hasMembership(boardId)
          && get(memberPath(boardId, request.auth.uid)).data.role == 'editor');
    }

    function invitePath(boardId, inviteId) {
      return /databases/$(database)/documents/kanbans/$(boardId)/invites/$(inviteId);
    }

    function profilePath(userId) {
      return /databases/$(database)/documents/profiles/$(userId);
    }

    function friendRequestPath(userId, requestId) {
      return /databases/$(database)/documents/users/$(userId)/friendRequests/$(requestId);
    }

    function friendPath(userId, friendId) {
      return /databases/$(database)/documents/users/$(userId)/friends/$(friendId);
    }

    function validProfile() {
      return request.resource.data.keys().hasAll(['displayName', 'bio', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['displayName', 'bio', 'updatedAt'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 80
        && request.resource.data.bio is string
        && request.resource.data.bio.size() <= 280
        && request.resource.data.updatedAt is timestamp;
    }

    match /profiles/{userId} {
      allow get: if signedIn();
      allow list: if false;
      allow create, update: if signedIn()
        && request.auth.uid == userId
        && validProfile();
      allow delete: if signedIn() && request.auth.uid == userId;
    }

    match /users/{userId}/kanban/{document=**} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    match /users/{userId}/friendRequests/{requestId} {
      allow read: if signedIn()
        && (request.auth.uid == userId
          || request.auth.uid == requestId
          || resource.data.fromUid == request.auth.uid);
      allow create: if signedIn()
        && userId != request.auth.uid
        && requestId == request.auth.uid
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toUid == userId
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt is timestamp
        && exists(profilePath(userId))
        && request.resource.data.keys().hasOnly(['fromUid', 'toUid', 'status', 'createdAt']);
      allow update: if signedIn()
        && request.auth.uid == userId
        && resource.data.status == 'pending'
        && request.resource.data.status == 'accepted'
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        && existsAfter(friendPath(userId, requestId))
        && existsAfter(friendPath(requestId, userId));
      allow delete: if signedIn()
        && (request.auth.uid == userId || request.auth.uid == resource.data.fromUid);
    }

    match /users/{userId}/friends/{friendId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create: if signedIn()
        && request.resource.data.uid == friendId
        && request.resource.data.requestRecipientUid is string
        && request.resource.data.requestSenderUid is string
        && request.resource.data.createdAt is timestamp
        && request.resource.data.keys().hasOnly([
          'uid', 'createdAt', 'requestRecipientUid', 'requestSenderUid'
        ])
        && (
          (userId == request.auth.uid
            && request.resource.data.requestRecipientUid == request.auth.uid
            && request.resource.data.requestSenderUid == friendId
            && existsAfter(friendRequestPath(userId, friendId))
            && getAfter(friendRequestPath(userId, friendId)).data.status == 'accepted')
          || (friendId == request.auth.uid
            && request.resource.data.requestRecipientUid == request.auth.uid
            && request.resource.data.requestSenderUid == userId
            && existsAfter(friendRequestPath(friendId, userId))
            && getAfter(friendRequestPath(friendId, userId)).data.status == 'accepted')
        );
      allow update: if false;
      allow delete: if signedIn()
        && (request.auth.uid == userId || request.auth.uid == friendId);
    }

    match /kanbans/{boardId} {
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0;
      allow read: if signedIn()
        && (resource.data.ownerId == request.auth.uid || hasMembership(boardId));
      allow update: if canEditBoard(boardId)
        && request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if isOwner(boardId);

      match /members/{memberId} {
        allow read: if canReadBoard(boardId);
        allow create: if signedIn()
          && request.auth.uid == memberId
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.role in ['editor', 'viewer']
          && request.resource.data.email == request.auth.token.email.lower()
          && exists(invitePath(boardId, request.resource.data.inviteId))
          && (get(invitePath(boardId, request.resource.data.inviteId)).data.invitedEmail
              == request.auth.token.email.lower()
            || get(invitePath(boardId, request.resource.data.inviteId)).data.invitedUid
              == request.auth.uid)
          && get(invitePath(boardId, request.resource.data.inviteId)).data.role
            == request.resource.data.role;
        allow update, delete: if isOwner(boardId);
      }

      match /invites/{inviteId} {
        allow read: if isOwner(boardId)
          || (signedIn()
            && (resource.data.invitedEmail == request.auth.token.email.lower()
              || resource.data.invitedUid == request.auth.uid));
        allow create: if isOwner(boardId)
          && request.resource.data.ownerId == request.auth.uid
          && request.resource.data.boardId == boardId
          && request.resource.data.role in ['editor', 'viewer']
          && (
            (request.resource.data.keys().hasAll(['invitedEmail'])
              && !request.resource.data.keys().hasAny(['invitedUid'])
              && request.resource.data.invitedEmail is string
              && request.resource.data.invitedEmail.size() > 3)
            || (request.resource.data.keys().hasAll(['invitedUid'])
              && !request.resource.data.keys().hasAny(['invitedEmail'])
              && request.resource.data.invitedUid is string
              && request.resource.data.invitedUid.size() > 0
              && exists(profilePath(request.resource.data.invitedUid)))
          );
        allow delete: if isOwner(boardId)
          || (signedIn()
            && (resource.data.invitedEmail == request.auth.token.email.lower()
              || resource.data.invitedUid == request.auth.uid));
        allow update: if false;
      }

      match /tasks/{taskId}/comments/{commentId} {
        allow read: if canReadBoard(boardId);
        allow create: if canReadBoard(boardId)
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.authorEmail == request.auth.token.email
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000;
        allow update, delete: if signedIn()
          && (resource.data.authorId == request.auth.uid || isOwner(boardId));
      }

      match /activity/{activityId} {
        allow read: if canReadBoard(boardId);
        allow create: if canEditBoard(boardId)
          && request.resource.data.actorId == request.auth.uid;
        allow update: if false;
        allow delete: if isOwner(boardId);
      }
    }

    match /{path=**}/members/{memberId} {
      allow read: if signedIn()
        && resource.data.uid == request.auth.uid;
    }

    match /{path=**}/invites/{inviteId} {
      allow read: if signedIn()
        && (resource.data.invitedEmail == request.auth.token.email.lower()
          || resource.data.invitedUid == request.auth.uid);
    }

    match /{path=**}/friendRequests/{requestId} {
      allow read: if signedIn()
        && (resource.data.fromUid == request.auth.uid
          || resource.data.toUid == request.auth.uid);
    }
  }
}
